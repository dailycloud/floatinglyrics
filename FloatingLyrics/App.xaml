<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="FloatingLyrics.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FloatingLyrics"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="LyricsBackdropStartColor">#FFF5FBFF</Color>
                    <Color x:Key="LyricsBackdropEndColor">#FFE7F0FF</Color>
                    <Color x:Key="LyricsCardColor">#D9FFFFFF</Color>
                    <Color x:Key="LyricsCardBorderColor">#4D7E96B5</Color>
                    <Color x:Key="LyricsPrimaryTextColor">#FF0D1726</Color>
                    <Color x:Key="LyricsSecondaryTextColor">#FF334E68</Color>
                    <Color x:Key="LyricsAccentColor">#FF0DAA9B</Color>
                    <Color x:Key="LyricsWarmAccentColor">#FFF78D2F</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="LyricsBackdropStartColor">#FF09121E</Color>
                    <Color x:Key="LyricsBackdropEndColor">#FF1D2C45</Color>
                    <Color x:Key="LyricsCardColor">#AA0D1826</Color>
                    <Color x:Key="LyricsCardBorderColor">#664B738F</Color>
                    <Color x:Key="LyricsPrimaryTextColor">#FFF7FAFF</Color>
                    <Color x:Key="LyricsSecondaryTextColor">#FFBCD0E7</Color>
                    <Color x:Key="LyricsAccentColor">#FF24CBB8</Color>
                    <Color x:Key="LyricsWarmAccentColor">#FFF7AE57</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <SolidColorBrush x:Key="LyricsCardBrush" Color="{ThemeResource LyricsCardColor}" />
            <SolidColorBrush x:Key="LyricsCardBorderBrush" Color="{ThemeResource LyricsCardBorderColor}" />
            <SolidColorBrush x:Key="LyricsPrimaryTextBrush" Color="{ThemeResource LyricsPrimaryTextColor}" />
            <SolidColorBrush x:Key="LyricsSecondaryTextBrush" Color="{ThemeResource LyricsSecondaryTextColor}" />
            <SolidColorBrush x:Key="LyricsAccentBrush" Color="{ThemeResource LyricsAccentColor}" />
            <SolidColorBrush x:Key="LyricsWarmAccentBrush" Color="{ThemeResource LyricsWarmAccentColor}" />

            <Style x:Key="PrimaryActionButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource LyricsAccentBrush}" />
                <Setter Property="Foreground" Value="#FF021B18" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="SecondaryActionButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource LyricsWarmAccentBrush}" />
                <Setter Property="Foreground" Value="#FF2F1B03" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
