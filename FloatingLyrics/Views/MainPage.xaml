                            </Grid>
                        </Border>
                    </Flyout>
                    </Border.ContextFlyout>
                </Border>
            </Grid>

            <Grid
                x:Name="OverlayTextBlockHost"
                HorizontalAlignment="Center">
                <StackPanel
                    x:Name="OverlayContentHost"
                    Opacity="1"
                    HorizontalAlignment="Stretch">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="OverlayContentHostTranslate" />
                    </StackPanel.RenderTransform>
                    <Grid
                        x:Name="TrackMetaGrid"
                        Canvas.ZIndex="10"
                        ColumnSpacing="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    x:Name="CoverArtShell"
                    Grid.Column="0"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Width="0"
                    Height="0"
                    Opacity="0"
                    IsHitTestVisible="False"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    RenderTransformOrigin="0.5,0.5"
                    CornerRadius="8"
                    BorderBrush="#55FFFFFF"
                    BorderThickness="1">
                    <Border.RenderTransform>
                        <ScaleTransform
                            x:Name="CoverArtScale"
                            ScaleX="0.9"
                            ScaleY="0.9" />
                    </Border.RenderTransform>
                    <Rectangle
                        RadiusX="8"
                        RadiusY="8">
                        <Rectangle.Fill>
                            <ImageBrush
                                ImageSource="{x:Bind ViewModel.CoverArtImage, Mode=OneWay}"
                                Stretch="UniformToFill" />
                        </Rectangle.Fill>
                    </Rectangle>
                </Border>

                <StackPanel
                    x:Name="TrackMetaTextHost"
                    Grid.Column="1"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Spacing="2"
                    HorizontalAlignment="Stretch">
                    <StackPanel
                        x:Name="TrackTitleRow"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left">
                        <TextBlock
                            x:Name="TrackTitleText"
                            FontFamily="Bahnschrift SemiBold"
                            FontSize="{x:Bind ViewModel.TitleFontSize, Mode=OneWay}"
                            Foreground="{x:Bind ViewModel.TrackTitleBrush, Mode=OneWay}"
                            Text="{x:Bind ViewModel.TrackTitleDisplay, Mode=OneWay}"
                            TextTrimming="None"
                            TextWrapping="NoWrap" />

                        <Viewbox
                            Width="19"
                            Height="19"
                            Margin="0,5,0,0"
                            VerticalAlignment="Top"
                            Visibility="{x:Bind ViewModel.UnsyncedIndicatorVisibility, Mode=OneWay}">
                            <ToolTipService.ToolTip>
                                <TextBlock Text="{x:Bind ViewModel.UnsyncedIndicatorToolTipText, Mode=OneWay}" />
                            </ToolTipService.ToolTip>
                            <Grid
                                Width="19"
                                Height="19">
                                <Ellipse
                                    Width="16"
                                    Height="16"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Stroke="#DCFFFFFF"
                                    StrokeThickness="1.5" />
                                <Path
                                    Data="M9.5,5.6 L9.5,9.2 L12.1,10.6"
                                    Stroke="#DCFFFFFF"
                                    StrokeStartLineCap="Round"
                                    StrokeEndLineCap="Round"
                                    StrokeThickness="1.5" />
                                <Path
                                    Data="M5.1,13.9 L13.9,5.1"
                                    Stroke="#DCFFFFFF"
                                    StrokeStartLineCap="Round"
                                    StrokeEndLineCap="Round"
                                    StrokeThickness="1.5" />
                            </Grid>
                        </Viewbox>
                    </StackPanel>

                    <TextBlock
                        x:Name="ArtistNameText"
                        Visibility="{x:Bind ViewModel.ArtistNameVisibility, Mode=OneWay}"
                        FontFamily="Segoe UI Variable Text"
                        FontSize="{x:Bind ViewModel.ArtistFontSize, Mode=OneWay}"
                        Foreground="{x:Bind ViewModel.ArtistBrush, Mode=OneWay}"
                        Text="{x:Bind ViewModel.ArtistName, Mode=OneWay}"
                        TextTrimming="None" />
                </StackPanel>
            </Grid>

                    <Border
                        Visibility="{x:Bind ViewModel.DebugOverlayVisibility, Mode=OneWay}"
                        Padding="8"
                        BorderBrush="#66FFFFFF"
                        BorderThickness="1"
                        CornerRadius="8"
                        Background="#C8141414"
                        MaxWidth="1120">
                <ScrollViewer
                    MaxHeight="220"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto"
                    ZoomMode="Disabled">
                    <TextBlock
                        x:Name="DebugMetricsText"
                        FontFamily="Consolas"
                        FontSize="12"
                        Foreground="#FFD1D9E6"
                        IsTextSelectionEnabled="True"
                        TextWrapping="NoWrap"
                        Text="" />
                </ScrollViewer>
                    </Border>

                    <Grid
                        Canvas.ZIndex="0"
                        Margin="0,6,0,0">
                <Grid
                    x:Name="LyricVisualizerHost"
                    MinHeight="120"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    IsHitTestVisible="False"
                    Opacity="0">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="VisualizerModeTranslate" />
                    </Grid.RenderTransform>
                    <Canvas
                        x:Name="LyricVisualizerCanvas"
                        Height="118"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top" />
                    <Border
                        Visibility="{x:Bind ViewModel.DebugOverlayVisibility, Mode=OneWay}"
                        BorderBrush="#99FFD54F"
                        BorderThickness="1"
                        Background="#14000000"
                        IsHitTestVisible="False" />
                </Grid>

                <Canvas
                    x:Name="LyricsCanvas"
                    UseLayoutRounding="False"
                    Opacity="1">
                    <Canvas.RenderTransform>
                        <TranslateTransform x:Name="LyricsModeTranslate" />
                    </Canvas.RenderTransform>

                    <Canvas
                        x:Name="LyricsTrackSurface"
                        Visibility="Collapsed"
                        IsHitTestVisible="False">
                        <Canvas.RenderTransform>
                            <TranslateTransform x:Name="LyricsTrackTranslate" />
                        </Canvas.RenderTransform>
                    </Canvas>

                    <Grid
                        x:Name="PreviousLineLayer"
                        RenderTransformOrigin="0,0"
                        UseLayoutRounding="False"
                        Opacity="0">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="PreviousLineScale" />
                                <TranslateTransform x:Name="PreviousLineTranslate" />
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <TextBlock
                            x:Name="PreviousLineShadowText"
                            Margin="1,1,0,0"
                            VerticalAlignment="Top"
                            FontFamily="Segoe UI Variable Text"
                            FontSize="{x:Bind ViewModel.NextLineFontSize, Mode=OneWay}"
                            IsHitTestVisible="False"
                            MaxLines="1"
                            TextTrimming="None"
                            TextWrapping="NoWrap"
                            RenderTransformOrigin="0,0">
                            <TextBlock.RenderTransform>
                                <ScaleTransform x:Name="PreviousLineShadowTextScale" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock
                            x:Name="PreviousLineText"
                            VerticalAlignment="Top"
                            FontFamily="Segoe UI Variable Text"
                            FontSize="{x:Bind ViewModel.NextLineFontSize, Mode=OneWay}"
                            MaxLines="1"
                            TextTrimming="None"
                            TextWrapping="NoWrap"
                            RenderTransformOrigin="0,0">
                            <TextBlock.RenderTransform>
                                <ScaleTransform x:Name="PreviousLineTextScale" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <Border
                            Visibility="{x:Bind ViewModel.DebugOverlayVisibility, Mode=OneWay}"
                            BorderBrush="#D1FF9800"
                            BorderThickness="1"
                            Background="#19FF9800"
                            IsHitTestVisible="False" />
                        <TextBlock
                            x:Name="PreviousHitboxDebugLabel"
                            Margin="4,1,0,0"
                            FontFamily="Consolas"
                            FontSize="11"
                            Foreground="#FF9800"
                            Visibility="{x:Bind ViewModel.DebugOverlayVisibility, Mode=OneWay}"
                            IsHitTestVisible="False"
                            Text="PREV" />
                    </Grid>

                    <Grid
                        x:Name="CurrentLineLayer"
                        RenderTransformOrigin="0,0"
                        UseLayoutRounding="False"
                        Opacity="1">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="CurrentLineScale" />
                                <TranslateTransform x:Name="CurrentLineTranslate" />
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <TextBlock
                            x:Name="CurrentLineShadowText"
                            Margin="1,1,0,0"
                            Opacity="0.95"
                            VerticalAlignment="Top"
                            FontFamily="Segoe UI Variable Text"
                            FontSize="{x:Bind ViewModel.CurrentLineFontSize, Mode=OneWay}"
                            IsHitTestVisible="False"
                            MaxLines="1"
                            TextTrimming="None"
                            TextWrapping="NoWrap"
                            RenderTransformOrigin="0,0">
                            <TextBlock.RenderTransform>
                                <ScaleTransform x:Name="CurrentLineShadowTextScale" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock
                            x:Name="CurrentLineText"
                            VerticalAlignment="Top"
                            FontFamily="Segoe UI Variable Text"
                            FontSize="{x:Bind ViewModel.CurrentLineFontSize, Mode=OneWay}"
                            MaxLines="1"
                            TextTrimming="None"
                            TextWrapping="NoWrap"
                            RenderTransformOrigin="0,0">
                            <TextBlock.RenderTransform>
                                <ScaleTransform x:Name="CurrentLineTextScale" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <Border
                            Visibility="{x:Bind ViewModel.DebugOverlayVisibility, Mode=OneWay}"
                            BorderBrush="#FF4CAF50"
                            BorderThickness="1"
                            Background="#154CAF50"
                            IsHitTestVisible="False" />
                        <TextBlock
                            x:Name="CurrentHitboxDebugLabel"
                            Margin="4,1,0,0"
                            FontFamily="Consolas"
                            FontSize="11"
                            Foreground="#FF4CAF50"
                            Visibility="{x:Bind ViewModel.DebugOverlayVisibility, Mode=OneWay}"
                            IsHitTestVisible="False"
                            Text="CURR" />
                    </Grid>

                    <Grid
                        x:Name="NextLineLayer"
                        RenderTransformOrigin="0,0"
                        UseLayoutRounding="False"
                        Opacity="0.72">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="NextLineScale" />
                                <TranslateTransform x:Name="NextLineTranslate" />
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <TextBlock
                            x:Name="NextLineShadowText"
                            Margin="1,1,0,0"
                            VerticalAlignment="Top"
                            FontFamily="Segoe UI Variable Text"
                            FontSize="{x:Bind ViewModel.NextLineFontSize, Mode=OneWay}"
                            IsHitTestVisible="False"
                            MaxLines="1"
                            TextTrimming="None"
                            TextWrapping="NoWrap"
                            RenderTransformOrigin="0,0">
                            <TextBlock.RenderTransform>
                                <ScaleTransform x:Name="NextLineShadowTextScale" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock
                            x:Name="NextLineText"
                            VerticalAlignment="Top"
                            FontFamily="Segoe UI Variable Text"
                            FontSize="{x:Bind ViewModel.NextLineFontSize, Mode=OneWay}"
                            MaxLines="1"
                            TextTrimming="None"
                            TextWrapping="NoWrap"
                            RenderTransformOrigin="0,0">
                            <TextBlock.RenderTransform>
                                <ScaleTransform x:Name="NextLineTextScale" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <Border
                            Visibility="{x:Bind ViewModel.DebugOverlayVisibility, Mode=OneWay}"
                            BorderBrush="#FF03A9F4"
                            BorderThickness="1"
                            Background="#1503A9F4"
                            IsHitTestVisible="False" />
                        <TextBlock
                            x:Name="NextHitboxDebugLabel"
                            Margin="4,1,0,0"
                            FontFamily="Consolas"
                            FontSize="11"
                            Foreground="#FF03A9F4"
                            Visibility="{x:Bind ViewModel.DebugOverlayVisibility, Mode=OneWay}"
                            IsHitTestVisible="False"
                            Text="NEXT" />
                    </Grid>

                </Canvas>

                <Grid
                    x:Name="PreRollHost"
                    Visibility="Collapsed"
                    MinHeight="110"
                    VerticalAlignment="Top"
                    Opacity="0">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="PreRollModeTranslate" />
                    </Grid.RenderTransform>
                    <StackPanel
                        x:Name="WaitingDotsLayer"
                        Orientation="Horizontal"
                        Height="18"
                        Margin="1,10,0,0"
                        Spacing="12"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Opacity="0">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="WaitingDotsTranslate" />
                        </StackPanel.RenderTransform>
                        <Ellipse
                            x:Name="WaitDot1"
                            Width="10"
                            Height="10"
                            Fill="#DDFFFFFF"
                            Opacity="0.34">
                            <Ellipse.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="WaitDot1Scale" CenterX="5" CenterY="5" ScaleX="1" ScaleY="1" />
                                    <TranslateTransform x:Name="WaitDot1Translate" />
                                </TransformGroup>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse
                            x:Name="WaitDot2"
                            Width="10"
                            Height="10"
                            Fill="#DDFFFFFF"
                            Opacity="0.34">
                            <Ellipse.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="WaitDot2Scale" CenterX="5" CenterY="5" ScaleX="1" ScaleY="1" />
                                    <TranslateTransform x:Name="WaitDot2Translate" />
                                </TransformGroup>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse
                            x:Name="WaitDot3"
                            Width="10"
                            Height="10"
                            Fill="#DDFFFFFF"
                            Opacity="0.34">
                            <Ellipse.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="WaitDot3Scale" CenterX="5" CenterY="5" ScaleX="1" ScaleY="1" />
                                    <TranslateTransform x:Name="WaitDot3Translate" />
                                </TransformGroup>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </StackPanel>

                    <TextBlock
                        x:Name="CountdownTextLayer"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="1,1,0,0"
                        FontFamily="Segoe UI Variable Display Semibold"
                        FontSize="60"
                        Foreground="White"
                        Text="{x:Bind ViewModel.PreRollCountdownText, Mode=OneWay}"
                        Opacity="0">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="CountdownTranslate" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <Border
                        Visibility="{x:Bind ViewModel.DebugOverlayVisibility, Mode=OneWay}"
                        BorderBrush="#99CE93D8"
                        BorderThickness="1"
                        Background="#10000000"
                        IsHitTestVisible="False" />
                </Grid>

                    </Grid>

                    <Grid
                        Margin="0,2,0,0"
                        ColumnSpacing="18"
                        Visibility="{x:Bind ViewModel.TimingsVisibility, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    FontFamily="Consolas"
                    FontSize="13"
                    Foreground="{x:Bind ViewModel.TimingBrush, Mode=OneWay}"
                    Text="{x:Bind ViewModel.CurrentLineTiming, Mode=OneWay}" />

                <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    FontFamily="Consolas"
                    FontSize="13"
                    Foreground="{x:Bind ViewModel.TimingBrush, Mode=OneWay}"
                    Text="{x:Bind ViewModel.NextLineTiming, Mode=OneWay}" />
                    </Grid>
                </StackPanel>
            </Grid>
        </StackPanel>

        <Border
            Canvas.ZIndex="500"
            Margin="14"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Visibility="{x:Bind ViewModel.RuntimeDebugPanelVisibility, Mode=OneWay}"
            IsHitTestVisible="False"
            MaxWidth="960"
            Padding="10"
            Background="#C0101010"
            BorderBrush="#5FFFFFFF"
            BorderThickness="1"
            CornerRadius="8">
            <ScrollViewer
                MaxHeight="260"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto"
                ZoomMode="Disabled">
                <TextBlock
                    x:Name="RuntimeDebugPanelText"
                    FontFamily="Consolas"
                    FontSize="12"
                    Foreground="#FFE6EEF6"
                    TextWrapping="NoWrap"
                    IsTextSelectionEnabled="True" />
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
