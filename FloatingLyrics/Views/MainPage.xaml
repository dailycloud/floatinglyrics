                        </Ellipse>
                    </StackPanel>

                    <TextBlock
                        x:Name="CountdownTextLayer"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="1,1,0,0"
                        FontFamily="Segoe UI Variable Display Semibold"
                        FontSize="60"
                        Foreground="White"
                        Text="{x:Bind ViewModel.PreRollCountdownText, Mode=OneWay}"
                        Opacity="0">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="CountdownTranslate" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <Border
                        Visibility="{x:Bind ViewModel.DebugOverlayVisibility, Mode=OneWay}"
                        BorderBrush="#99CE93D8"
                        BorderThickness="1"
                        Background="#10000000"
                        IsHitTestVisible="False" />
                </Grid>

                    </Grid>

                    <Grid
                        Margin="0,2,0,0"
                        ColumnSpacing="18"
                        Visibility="{x:Bind ViewModel.TimingsVisibility, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    FontFamily="Consolas"
                    FontSize="13"
                    Foreground="{x:Bind ViewModel.TimingBrush, Mode=OneWay}"
                    Text="{x:Bind ViewModel.CurrentLineTiming, Mode=OneWay}" />

                <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    FontFamily="Consolas"
                    FontSize="13"
                    Foreground="{x:Bind ViewModel.TimingBrush, Mode=OneWay}"
                    Text="{x:Bind ViewModel.NextLineTiming, Mode=OneWay}" />
                    </Grid>
                </StackPanel>
            </Grid>
            </StackPanel>

            <!-- Hover toolbar: small glass capsule above the plate's top-right corner. -->
            <Canvas
                x:Name="ToolbarLayer"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">
                <Grid
                    x:Name="WidgetToolbar"
                    Opacity="0"
                    Visibility="Collapsed"
                    RenderTransformOrigin="1,1">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="WidgetToolbarScale" />
                    </Grid.RenderTransform>
                    <controls:LiquidGlassSurface
                        x:Name="ToolbarGlass"
                        Margin="-44"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top" />
                    <StackPanel
                        x:Name="WidgetToolbarButtons"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Orientation="Horizontal"
                        Padding="6"
                        Spacing="4">
                        <Button
                            x:Name="ToolbarAttributionButton"
                            Visibility="Collapsed"
                            Padding="10,0"
                            MinHeight="0"
                            VerticalAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="14"
                            Click="ToolbarAttributionButton_OnClick"
                            AutomationProperties.Name="Источник текста">
                            <TextBlock
                                x:Name="ToolbarAttributionText"
                                FontSize="12"
                                Foreground="#E6FFFFFF"
                                MaxWidth="260"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center" />
                        </Button>
                        <Button
                            x:Name="ToolbarRefreshButton"
                            Style="{StaticResource GlassIconButtonStyle}"
                            Click="SettingsRefreshButton_OnClick"
                            AutomationProperties.Name="Обновить текст"
                            Content="&#xE72C;" />
                        <Button
                            x:Name="ToolbarSettingsButton"
                            Style="{StaticResource GlassIconButtonStyle}"
                            Click="ToolbarSettingsButton_OnClick"
                            AutomationProperties.Name="Настройки"
                            Content="&#xE713;" />
                    </StackPanel>
                </Grid>
            </Canvas>
        </Grid>

        <!-- ================================================================ glass menu -->
        <Canvas
            x:Name="SettingsLayer"
            HorizontalAlignment="Left"
            VerticalAlignment="Top">
            <Grid
                x:Name="SettingsPanel"
                Width="372"
                Height="600"
                Visibility="Collapsed"
                Opacity="0"
                RenderTransformOrigin="0,0">
                <Grid.RenderTransform>
                    <CompositeTransform x:Name="SettingsPanelTransform" />
                </Grid.RenderTransform>

                <controls:LiquidGlassSurface
                    x:Name="SettingsGlass"
                    Margin="-44"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top" />

                <Grid
                    x:Name="SettingsPanelContent"
                    Padding="16,14,16,12"
                    RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="40"
                            Height="40"
                            CornerRadius="11"
                            BorderBrush="#40FFFFFF"
                            BorderThickness="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Offset="0" Color="#55FFFFFF" />
                                    <GradientStop Offset="1" Color="#14FFFFFF" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Rectangle RadiusX="10" RadiusY="10">
                                    <Rectangle.Fill>
                                        <ImageBrush ImageSource="{x:Bind ViewModel.CoverArtImage, Mode=OneWay}" Stretch="UniformToFill" />
                                    </Rectangle.Fill>
                                </Rectangle>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                            <TextBlock
                                FontFamily="{StaticResource GlassUiDisplayFont}"
                                FontSize="17"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource GlassTextPrimary}"
                                Text="Floating Lyrics" />
                            <TextBlock
                                FontFamily="{StaticResource GlassUiFont}"
                                FontSize="12"
                                Foreground="{StaticResource GlassTextSecondary}"
                                MaxLines="1"
                                TextTrimming="CharacterEllipsis"
                                Text="{x:Bind local:MainPage.FormatNowPlaying(ViewModel.TrackTitle, ViewModel.ArtistName), Mode=OneWay}" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            Width="30"
                            Height="30"
                            FontSize="11"
                            Style="{StaticResource GlassIconButtonStyle}"
                            Click="CloseSettingsButton_OnClick"
                            AutomationProperties.Name="Закрыть"
                            Content="&#xE711;" />
                    </Grid>

                    <!-- Tabs -->
                    <Border Grid.Row="1" Style="{StaticResource GlassSegmentHostStyle}">
                        <Grid x:Name="SettingsTabs" ColumnSpacing="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="FirstSettingsTab" Grid.Column="0" GroupName="SettingsTab" Tag="0" Style="{StaticResource GlassTabStyle}" Checked="SettingsTab_OnChecked">
                                <StackPanel Spacing="3">
                                    <FontIcon Glyph="&#xE790;" FontSize="15" />
                                    <TextBlock Text="Стекло" HorizontalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Grid.Column="1" GroupName="SettingsTab" Tag="1" Style="{StaticResource GlassTabStyle}" Checked="SettingsTab_OnChecked">
                                <StackPanel Spacing="3">
                                    <FontIcon Glyph="&#xE8D2;" FontSize="15" />
                                    <TextBlock Text="Текст" HorizontalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Grid.Column="2" GroupName="SettingsTab" Tag="2" Style="{StaticResource GlassTabStyle}" Checked="SettingsTab_OnChecked">
                                <StackPanel Spacing="3">
                                    <FontIcon Glyph="&#xE768;" FontSize="15" />
                                    <TextBlock Text="Движение" HorizontalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Grid.Column="3" GroupName="SettingsTab" Tag="3" Style="{StaticResource GlassTabStyle}" Checked="SettingsTab_OnChecked">
                                <StackPanel Spacing="3">
                                    <FontIcon Glyph="&#xE7F4;" FontSize="15" />
                                    <TextBlock Text="Виджет" HorizontalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Grid.Column="4" GroupName="SettingsTab" Tag="4" Style="{StaticResource GlassTabStyle}" Checked="SettingsTab_OnChecked">
                                <StackPanel Spacing="3">
                                    <FontIcon Glyph="&#xE712;" FontSize="15" />
                                    <TextBlock Text="Ещё" HorizontalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </Grid>
                    </Border>

                    <ScrollViewer
                        x:Name="SettingsScroll"
                        Grid.Row="2"
                        Margin="-6,0,-10,0"
                        Padding="6,0,10,0"
                        VerticalScrollBarVisibility="Hidden"
                        VerticalScrollMode="Enabled"
                        HorizontalScrollMode="Disabled"
                        ZoomMode="Disabled">
                        <Grid x:Name="SettingsPages">

                            <!-- ============================== Page 0: Glass -->
                            <StackPanel x:Name="SettingsPageGlass" Spacing="8">
                                <TextBlock Style="{StaticResource GlassSectionTitleStyle}" Text="ПОДЛОЖКА" />
                                <Border Style="{StaticResource GlassSegmentHostStyle}">
                                    <Grid x:Name="GlassVisibilityChoices" ColumnSpacing="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <RadioButton Grid.Column="0" GroupName="GlassVisibility" Tag="OnHover" Content="При наведении" Style="{StaticResource GlassChipStyle}" />
                                        <RadioButton Grid.Column="1" GroupName="GlassVisibility" Tag="Always" Content="Всегда" Style="{StaticResource GlassChipStyle}" />
                                        <RadioButton Grid.Column="2" GroupName="GlassVisibility" Tag="Hidden" Content="Скрыта" Style="{StaticResource GlassChipStyle}" />
                                    </Grid>
                                </Border>

                                <TextBlock Margin="6,8,0,0" Style="{StaticResource GlassSectionTitleStyle}" Text="МАТЕРИАЛ" />
                                <Border Style="{StaticResource GlassGroupStyle}">
                                    <StackPanel Spacing="10">
                                        <Grid>
                                            <TextBlock Style="{StaticResource GlassLabelStyle}" Text="Размытие" />
                                            <TextBlock Style="{StaticResource GlassValueStyle}" Text="{x:Bind local:MainPage.FormatNumber(ViewModel.GlassBlur), Mode=OneWay}" />
                                        </Grid>
                                        <Slider Style="{StaticResource GlassSliderStyle}" Minimum="0" Maximum="40" StepFrequency="0.5" Value="{x:Bind ViewModel.GlassBlur, Mode=TwoWay}" />
                                        <Grid>
                                            <TextBlock Style="{StaticResource GlassLabelStyle}" Text="Преломление" />
                                            <TextBlock Style="{StaticResource GlassValueStyle}" Text="{x:Bind local:MainPage.FormatPercent(ViewModel.GlassRefraction), Mode=OneWay}" />
                                        </Grid>
                                        <Slider Style="{StaticResource GlassSliderStyle}" Minimum="0" Maximum="1" StepFrequency="0.01" Value="{x:Bind ViewModel.GlassRefraction, Mode=TwoWay}" />
                                        <Grid>
                                            <TextBlock Style="{StaticResource GlassLabelStyle}" Text="Дисперсия" />
                                            <TextBlock Style="{StaticResource GlassValueStyle}" Text="{x:Bind local:MainPage.FormatPercent(ViewModel.GlassDispersion), Mode=OneWay}" />
                                        </Grid>
                                        <Slider Style="{StaticResource GlassSliderStyle}" Minimum="0" Maximum="1" StepFrequency="0.01" Value="{x:Bind ViewModel.GlassDispersion, Mode=TwoWay}" />
                                        <Grid>
                                            <TextBlock Style="{StaticResource GlassLabelStyle}" Text="Блики" />
                                            <TextBlock Style="{StaticResource GlassValueStyle}" Text="{x:Bind local:MainPage.FormatPercent(ViewModel.GlassSpecular), Mode=OneWay}" />
                                        </Grid>
                                        <Slider Style="{StaticResource GlassSliderStyle}" Minimum="0" Maximum="1" StepFrequency="0.01" Value="{x:Bind ViewModel.GlassSpecular, Mode=TwoWay}" />
                                        <Grid>
                                            <TextBlock Style="{StaticResource GlassLabelStyle}" Text="Свет за курсором" />
                                            <ToggleSwitch Style="{StaticResource GlassToggleStyle}" IsOn="{x:Bind ViewModel.GlassCursorLight, Mode=TwoWay}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <TextBlock Margin="6,8,0,0" Style="{StaticResource GlassSectionTitleStyle}" Text="ТОНИРОВКА" />
                                <Border Style="{StaticResource GlassGroupStyle}">
                                    <StackPanel Spacing="10">
                                        <StackPanel x:Name="GlassTintChoices" Orientation="Horizontal" Spacing="8">
                                            <RadioButton GroupName="GlassTint" Tag="Clear" Background="#33FFFFFF" Style="{StaticResource GlassSwatchStyle}" AutomationProperties.Name="Прозрачная" />
                                            <RadioButton GroupName="GlassTint" Tag="Smoke" Background="#FF1A1E27" Style="{StaticResource GlassSwatchStyle}" AutomationProperties.Name="Дымчатая" />
                                            <RadioButton GroupName="GlassTint" Tag="Frost" Background="#FFEEF2F8" Style="{StaticResource GlassSwatchStyle}" AutomationProperties.Name="Иней" />
                                            <RadioButton x:Name="ArtworkTintSwatch" GroupName="GlassTint" Tag="Artwork" Background="#FF79B7F4" Style="{StaticResource GlassSwatchStyle}" AutomationProperties.Name="Цвет обложки" />
                                            <RadioButton GroupName="GlassTint" Tag="Ocean" Background="#FF1F5FA8" Style="{StaticResource GlassSwatchStyle}" AutomationProperties.Name="Океан" />
                                            <RadioButton GroupName="GlassTint" Tag="Rose" Background="#FFB03A78" Style="{StaticResource GlassSwatchStyle}" AutomationProperties.Name="Роза" />
                                        </StackPanel>
                                        <TextBlock x:Name="GlassTintCaption" Style="{StaticResource GlassCaptionStyle}" Text="Дымчатая" />
                                        <Grid>
                                            <TextBlock Style="{StaticResource GlassLabelStyle}" Text="Плотность" />
                                            <TextBlock Style="{StaticResource GlassValueStyle}" Text="{x:Bind local:MainPage.FormatPercent(ViewModel.GlassTintStrength), Mode=OneWay}" />
                                        </Grid>
                                        <Slider Style="{StaticResource GlassSliderStyle}" Minimum="0" Maximum="0.9" StepFrequency="0.01" Value="{x:Bind ViewModel.GlassTintStrength, Mode=TwoWay}" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Margin="6,8,0,0" Style="{StaticResource GlassSectionTitleStyle}" Text="ФОРМА" />
                                <Border Style="{StaticResource GlassGroupStyle}">
                                    <StackPanel Spacing="10">
                                        <Grid>
                                            <TextBlock Style="{StaticResource GlassLabelStyle}" Text="Скругление" />
                                            <TextBlock Style="{StaticResource GlassValueStyle}" Text="{x:Bind local:MainPage.FormatNumber(ViewModel.GlassCornerRadius), Mode=OneWay}" />
                                        </Grid>
                                        <Slider Style="{StaticResource GlassSliderStyle}" Minimum="8" Maximum="56" StepFrequency="1" Value="{x:Bind ViewModel.GlassCornerRadius, Mode=TwoWay}" />
                                        <Grid>
                                            <TextBlock Style="{StaticResource GlassLabelStyle}" Text="Отступы" />
                                            <TextBlock Style="{StaticResource GlassValueStyle}" Text="{x:Bind local:MainPage.FormatNumber(ViewModel.GlassPadding), Mode=OneWay}" />
                                        </Grid>
                                        <Slider Style="{StaticResource GlassSliderStyle}" Minimum="8" Maximum="56" StepFrequency="1" Value="{x:Bind ViewModel.GlassPadding, Mode=TwoWay}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ============================== Page 1: Text -->
                            <StackPanel x:Name="SettingsPageText" Spacing="8" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource GlassSectionTitleStyle}" Text="ЦВЕТ" />
                                <Border Style="{StaticResource GlassGroupStyle}">
                                    <StackPanel Spacing="10">
                                        <StackPanel x:Name="LyricsColorChoices" Orientation="Horizontal" Spacing="8">
                                            <RadioButton GroupName="LyricsColor" Tag="ClassicWhite" Background="#FFFFFFFF" Style="{StaticResource GlassSwatchStyle}" AutomationProperties.Name="Белый" />
                                            <RadioButton GroupName="LyricsColor" Tag="WarmAmber" Background="#FFF4BE78" Style="{StaticResource GlassSwatchStyle}" AutomationProperties.Name="Янтарь" />
                                            <RadioButton GroupName="LyricsColor" Tag="IceBlue" Background="#FFB3DAF6" Style="{StaticResource GlassSwatchStyle}" AutomationProperties.Name="Лёд" />
                                            <RadioButton GroupName="LyricsColor" Tag="Mint" Background="#FFA0ECD4" Style="{StaticResource GlassSwatchStyle}" AutomationProperties.Name="Мята" />
                                        </StackPanel>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Style="{StaticResource GlassLabelStyle}" Text="Цвета из обложки" />
                                                <TextBlock Style="{StaticResource GlassCaptionStyle}" Text="Подстраивать оттенок под альбом" />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1" Style="{StaticResource GlassToggleStyle}" IsOn="{x:Bind ViewModel.UseArtworkTextColors, Mode=TwoWay}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <TextBlock Margin="6,8,0,0" Style="{StaticResource GlassSectionTitleStyle}" Text="КОНТРАСТ" />
                                <Border Style="{StaticResource GlassSegmentHostStyle}">
                                    <Grid x:Name="TextContrastChoices" ColumnSpacing="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <RadioButton Grid.Column="0" GroupName="TextContrast" Tag="Auto" Content="Авто" Style="{StaticResource GlassChipStyle}" />
                                        <RadioButton Grid.Column="1" GroupName="TextContrast" Tag="Light" Content="Светлый" Style="{StaticResource GlassChipStyle}" />
                                        <RadioButton Grid.Column="2" GroupName="TextContrast" Tag="Dark" Content="Тёмный" Style="{StaticResource GlassChipStyle}" />
                                        <RadioButton Grid.Column="3" GroupName="TextContrast" Tag="Invert" Content="Инверсия" Style="{StaticResource GlassChipStyle}" />
                                    </Grid>
                                </Border>
                                <TextBlock
                                    Margin="6,0,6,0"
                                    Style="{StaticResource GlassCaptionStyle}"
                                    Text="Авто подбирает светлый или тёмный текст по обоям. Инверсия красит каждую часть буквы: белым над тёмным, чёрным над светлым." />

                                <TextBlock Margin="6,8,0,0" Style="{StaticResource GlassSectionTitleStyle}" Text="ШРИФТ" />
                                <Border Style="{StaticResource GlassGroupStyle}" Padding="8">
                                    <StackPanel Spacing="8">
                                        <Grid x:Name="LyricsFontChoices" ColumnSpacing="4" RowSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <RadioButton Grid.Row="0" Grid.Column="0" GroupName="LyricsFont" Tag="SegoeVariable" Style="{StaticResource GlassChipStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="Аа" FontSize="20" FontFamily="Segoe UI Variable Text" HorizontalAlignment="Center" />
                                                    <TextBlock Text="Segoe" FontSize="11" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton Grid.Row="0" Grid.Column="1" GroupName="LyricsFont" Tag="SegoeDisplay" Style="{StaticResource GlassChipStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="Аа" FontSize="20" FontFamily="Segoe UI Variable Display" FontWeight="Bold" HorizontalAlignment="Center" />
                                                    <TextBlock Text="Display" FontSize="11" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton Grid.Row="0" Grid.Column="2" GroupName="LyricsFont" Tag="Bahnschrift" Style="{StaticResource GlassChipStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="Аа" FontSize="20" FontFamily="Bahnschrift" HorizontalAlignment="Center" />
                                                    <TextBlock Text="Bahnschrift" FontSize="11" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton Grid.Row="1" Grid.Column="0" GroupName="LyricsFont" Tag="Georgia" Style="{StaticResource GlassChipStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="Аа" FontSize="20" FontFamily="Georgia" HorizontalAlignment="Center" />
                                                    <TextBlock Text="Georgia" FontSize="11" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton Grid.Row="1" Grid.Column="1" GroupName="LyricsFont" Tag="Consolas" Style="{StaticResource GlassChipStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="Аа" FontSize="20" FontFamily="Cascadia Mono, Consolas" HorizontalAlignment="Center" />
                                                    <TextBlock Text="Mono" FontSize="11" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </RadioButton>
                                        </Grid>
                                        <Border Style="{StaticResource GlassSegmentHostStyle}">
                                            <Grid x:Name="LyricsWeightChoices" ColumnSpacing="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <RadioButton Grid.Column="0" GroupName="LyricsWeight" Tag="Light" Content="Тонкий" FontWeight="Light" Style="{StaticResource GlassChipStyle}" />
                                                <RadioButton Grid.Column="1" GroupName="LyricsWeight" Tag="Regular" Content="Обычный" Style="{StaticResource GlassChipStyle}" />
                                                <RadioButton Grid.Column="2" GroupName="LyricsWeight" Tag="Semibold" Content="Плотный" FontWeight="SemiBold" Style="{StaticResource GlassChipStyle}" />
                                                <RadioButton Grid.Column="3" GroupName="LyricsWeight" Tag="Bold" Content="Жирный" FontWeight="Bold" Style="{StaticResource GlassChipStyle}" />
                                            </Grid>
                                        </Border>
                                        <Grid Margin="6,4,6,0">
                                            <TextBlock Style="{StaticResource GlassLabelStyle}" Text="Свой шрифт" />
                                            <TextBlock x:Name="CustomFontValue" Style="{StaticResource GlassValueStyle}" MaxWidth="180" TextTrimming="CharacterEllipsis" Text="не выбран" />
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Style="{StaticResource GlassActionButtonStyle}" Click="ToggleFontListButton_OnClick" Content="Выбрать шрифт" />
                                            <Button Grid.Column="1" Style="{StaticResource GlassActionButtonStyle}" Click="LoadFontFileButton_OnClick" Content="Из файла…" />
                                        </Grid>
                                        <TextBlock
                                            x:Name="FontHint"
                                            Margin="6,0"
                                            Visibility="Collapsed"
                                            FontSize="12"
                                            Foreground="#B3FFFFFF"
                                            TextWrapping="Wrap" />
                                        <ListView
                                            x:Name="FontList"
                                            Height="240"
                                            Visibility="Collapsed"
                                            SelectionMode="Single"
                                            IsItemClickEnabled="True"
                                            ItemClick="FontList_OnItemClick">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="local:FontChoice">
                                                    <TextBlock
                                                        Padding="2,6"
                                                        FontSize="16"
                                                        Foreground="#F2FFFFFF"
                                                        FontFamily="{x:Bind Family}"
                                                        Text="{x:Bind Name}" />
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </StackPanel>
                                </Border>

                                <TextBlock Margin="6,8,0,0" Style="{StaticResource GlassSectionTitleStyle}" Text="ВЫРАВНИВАНИЕ" />
                                <Border Style="{StaticResource GlassSegmentHostStyle}">
                                    <Grid x:Name="LyricsAlignmentChoices" ColumnSpacing="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <RadioButton Grid.Column="0" GroupName="LyricsAlignment" Tag="Auto" Content="Авто" Style="{StaticResource GlassChipStyle}" />
                                        <RadioButton Grid.Column="1" GroupName="LyricsAlignment" Tag="Left" Content="Слева" Style="{StaticResource GlassChipStyle}" />
                                        <RadioButton Grid.Column="2" GroupName="LyricsAlignment" Tag="Center" Content="Центр" Style="{StaticResource GlassChipStyle}" />
                                        <RadioButton Grid.Column="3" GroupName="LyricsAlignment" Tag="Right" Content="Справа" Style="{StaticResource GlassChipStyle}" />
                                    </Grid>
                                </Border>

                                <TextBlock Margin="6,8,0,0" Style="{StaticResource GlassSectionTitleStyle}" Text="РАЗМЕРЫ" />
                                <Border Style="{StaticResource GlassGroupStyle}">
                                    <StackPanel Spacing="10">
                                        <Grid>
                                            <TextBlock Style="{StaticResource GlassLabelStyle}" Text="Текущая строка" />
                                            <TextBlock Style="{StaticResource GlassValueStyle}" Text="{x:Bind local:MainPage.FormatNumber(ViewModel.CurrentLineFontSize), Mode=OneWay}" />
                                        </Grid>
                                        <Slider Style="{StaticResource GlassSliderStyle}" Minimum="20" Maximum="84" StepFrequency="1" Value="{x:Bind ViewModel.CurrentLineFontSize, Mode=TwoWay}" />
                                        <Grid>
                                            <TextBlock Style="{StaticResource GlassLabelStyle}" Text="Следующая строка" />
                                            <TextBlock Style="{StaticResource GlassValueStyle}" Text="{x:Bind local:MainPage.FormatNumber(ViewModel.NextLineFontSize), Mode=OneWay}" />
                                        </Grid>
                                        <Slider Style="{StaticResource GlassSliderStyle}" Minimum="16" Maximum="54" StepFrequency="1" Value="{x:Bind ViewModel.NextLineFontSize, Mode=TwoWay}" />
                                        <Grid>
                                            <TextBlock Style="{StaticResource GlassLabelStyle}" Text="Название трека" />
                                            <TextBlock Style="{StaticResource GlassValueStyle}" Text="{x:Bind local:MainPage.FormatNumber(ViewModel.TitleFontSize), Mode=OneWay}" />
                                        </Grid>
                                        <Slider Style="{StaticResource GlassSliderStyle}" Minimum="16" Maximum="54" StepFrequency="1" Value="{x:Bind ViewModel.TitleFontSize, Mode=TwoWay}" />
                                        <Grid>
                                            <TextBlock Style="{StaticResource GlassLabelStyle}" Text="Интервал строк" />
                                            <TextBlock Style="{StaticResource GlassValueStyle}" Text="{x:Bind local:MainPage.FormatNumber(ViewModel.NextLineTopMargin), Mode=OneWay}" />
                                        </Grid>
                                        <Slider Style="{StaticResource GlassSliderStyle}" Minimum="0" Maximum="48" StepFrequency="1" Value="{x:Bind ViewModel.NextLineTopMargin, Mode=TwoWay}" />
                                        <Grid>
                                            <TextBlock Style="{StaticResource GlassLabelStyle}" Text="Тень текста" />
                                            <TextBlock Style="{StaticResource GlassValueStyle}" Text="{x:Bind local:MainPage.FormatPercent(ViewModel.TextShadowOpacity), Mode=OneWay}" />
                                        </Grid>
                                        <Slider Style="{StaticResource GlassSliderStyle}" Minimum="0.05" Maximum="1" StepFrequency="0.01" Value="{x:Bind ViewModel.TextShadowOpacity, Mode=TwoWay}" />
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,8,0,0" Style="{StaticResource GlassGroupStyle}">
                                    <StackPanel Spacing="12">
                                        <Grid>
                                            <TextBlock Style="{StaticResource GlassLabelStyle}" Text="Тайминги строк" />
                                            <ToggleSwitch Style="{StaticResource GlassToggleStyle}" IsOn="{x:Bind ViewModel.ShowLineTimings, Mode=TwoWay}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ============================== Page 2: Motion -->
                            <StackPanel x:Name="SettingsPageMotion" Spacing="8" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource GlassSectionTitleStyle}" Text="ПО СЛОВАМ" />
                                <Border Style="{StaticResource GlassGroupStyle}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource GlassLabelStyle}" Text="Подсветка по словам" />
                                            <TextBlock Style="{StaticResource GlassCaptionStyle}" Text="{x:Bind local:MainPage.FormatSpicyStatus(ViewModel.HasSpicyLyricsKey), Mode=OneWay}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" Style="{StaticResource GlassToggleStyle}" IsOn="{x:Bind ViewModel.WordByWordHighlight, Mode=TwoWay}" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource GlassGroupStyle}">
                                    <StackPanel Spacing="10">
                                        <Grid>
                                            <TextBlock Style="{StaticResource GlassLabelStyle}" Text="Сдвиг синхронизации" />
                                            <TextBlock Style="{StaticResource GlassValueStyle}" Text="{x:Bind local:MainPage.FormatOffset(ViewModel.LyricsOffsetMs), Mode=OneWay}" />
                                        </Grid>
                                        <Slider Style="{StaticResource GlassSliderStyle}" Minimum="-1500" Maximum="1500" StepFrequency="10" Value="{x:Bind ViewModel.LyricsOffsetMs, Mode=TwoWay}" />
                                        <TextBlock Style="{StaticResource GlassCaptionStyle}" Text="Если слова подсвечиваются раньше пения — сдвиньте вправо, если позже — влево." />
                                    </StackPanel>
                                </Border>

                                <TextBlock Margin="6,8,0,0" Style="{StaticResource GlassSectionTitleStyle}" Text="СМЕНА СТРОК" />
                                <Border Style="{StaticResource GlassSegmentHostStyle}">
                                    <Grid x:Name="LineAnimationChoices" ColumnSpacing="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <RadioButton Grid.Column="0" GroupName="LineAnimation" Tag="Smooth" Content="Плавно" Style="{StaticResource GlassChipStyle}" />
                                        <RadioButton Grid.Column="1" GroupName="LineAnimation" Tag="Spring" Content="Пружина" Style="{StaticResource GlassChipStyle}" />
                                        <RadioButton Grid.Column="2" GroupName="LineAnimation" Tag="Snappy" Content="Резко" Style="{StaticResource GlassChipStyle}" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource GlassGroupStyle}">
                                    <StackPanel Spacing="10">
                                        <Grid>
                                            <TextBlock Style="{StaticResource GlassLabelStyle}" Text="Длительность" />
                                            <TextBlock Style="{StaticResource GlassValueStyle}" Text="{x:Bind local:MainPage.FormatSeconds(ViewModel.LineAnimationDurationSeconds), Mode=OneWay}" />
                                        </Grid>
                                        <Slider Style="{StaticResource GlassSliderStyle}" Minimum="0.12" Maximum="1.2" StepFrequency="0.01" Value="{x:Bind ViewModel.LineAnimationDurationSeconds, Mode=TwoWay}" />
                                        <Grid>
                                            <TextBlock Style="{StaticResource GlassLabelStyle}" Text="Затухание по краям" />
                                            <TextBlock Style="{StaticResource GlassValueStyle}" Text="{x:Bind local:MainPage.FormatNumber(ViewModel.ViewportFadeZone), Mode=OneWay}" />
                                        </Grid>
                                        <Slider Style="{StaticResource GlassSliderStyle}" Minimum="0" Maximum="180" StepFrequency="1" Value="{x:Bind ViewModel.ViewportFadeZone, Mode=TwoWay}" />
                                        <Grid>
                                            <TextBlock Style="{StaticResource GlassLabelStyle}" Text="Мягкость затухания" />
                                            <TextBlock Style="{StaticResource GlassValueStyle}" Text="{x:Bind local:MainPage.FormatDecimal(ViewModel.ViewportFadeSoftness), Mode=OneWay}" />
                                        </Grid>
                                        <Slider Style="{StaticResource GlassSliderStyle}" Minimum="0.4" Maximum="2.2" StepFrequency="0.01" Value="{x:Bind ViewModel.ViewportFadeSoftness, Mode=TwoWay}" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Margin="6,8,0,0" Style="{StaticResource GlassSectionTitleStyle}" Text="ВИЗУАЛИЗАТОР" />
                                <Border Style="{StaticResource GlassGroupStyle}">
                                    <StackPanel Spacing="10">
                                        <Grid>
                                            <TextBlock Style="{StaticResource GlassLabelStyle}" Text="Зеркальные полосы" />
                                            <ToggleSwitch Style="{StaticResource GlassToggleStyle}" IsOn="{x:Bind ViewModel.OscilloscopeMirrorBars, Mode=TwoWay}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Style="{StaticResource GlassLabelStyle}" Text="Звук только плеера" />
                                                <TextBlock Style="{StaticResource GlassCaptionStyle}" Text="Бета: захват аудио активного приложения" />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1" Style="{StaticResource GlassToggleStyle}" IsOn="{x:Bind ViewModel.AppScopedAudioCapture, Mode=TwoWay}" />
                                        </Grid>
                                        <Grid>
                                            <TextBlock Style="{StaticResource GlassLabelStyle}" Text="Чувствительность" />
                                            <TextBlock Style="{StaticResource GlassValueStyle}" Text="{x:Bind local:MainPage.FormatDecimal(ViewModel.OscilloscopeSensitivity), Mode=OneWay}" />
                                        </Grid>
                                        <Slider Style="{StaticResource GlassSliderStyle}" Minimum="0.5" Maximum="2.6" StepFrequency="0.01" Value="{x:Bind ViewModel.OscilloscopeSensitivity, Mode=TwoWay}" />
                                        <Grid>
                                            <TextBlock Style="{StaticResource GlassLabelStyle}" Text="Отзывчивость" />
                                            <TextBlock Style="{StaticResource GlassValueStyle}" Text="{x:Bind local:MainPage.FormatPercent(ViewModel.OscilloscopeResponsiveness), Mode=OneWay}" />
                                        </Grid>
                                        <Slider Style="{StaticResource GlassSliderStyle}" Minimum="0.08" Maximum="0.95" StepFrequency="0.01" Value="{x:Bind ViewModel.OscilloscopeResponsiveness, Mode=TwoWay}" />
                                        <Grid>
                                            <TextBlock Style="{StaticResource GlassLabelStyle}" Text="Детализация" />
                                            <TextBlock Style="{StaticResource GlassValueStyle}" Text="{x:Bind local:MainPage.FormatNumber(ViewModel.OscilloscopeDetail), Mode=OneWay}" />
                                        </Grid>
                                        <Slider Style="{StaticResource GlassSliderStyle}" Minimum="96" Maximum="320" StepFrequency="2" Value="{x:Bind ViewModel.OscilloscopeDetail, Mode=TwoWay}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ============================== Page 3: Widget -->
                            <StackPanel x:Name="SettingsPageWidget" Spacing="8" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource GlassSectionTitleStyle}" Text="ПОЛОЖЕНИЕ" />
                                <Border Style="{StaticResource GlassGroupStyle}">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="132" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid x:Name="AnchorGrid" Height="88" ColumnSpacing="4" RowSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Button Grid.Row="0" Grid.Column="0" Tag="0,0" Style="{StaticResource GlassAnchorButtonStyle}" Click="AnchorButton_OnClick" />
                                            <Button Grid.Row="0" Grid.Column="1" Tag="1,0" Style="{StaticResource GlassAnchorButtonStyle}" Click="AnchorButton_OnClick" />
                                            <Button Grid.Row="0" Grid.Column="2" Tag="2,0" Style="{StaticResource GlassAnchorButtonStyle}" Click="AnchorButton_OnClick" />
                                            <Button Grid.Row="1" Grid.Column="0" Tag="0,1" Style="{StaticResource GlassAnchorButtonStyle}" Click="AnchorButton_OnClick" />
                                            <Button Grid.Row="1" Grid.Column="1" Tag="1,1" Style="{StaticResource GlassAnchorButtonStyle}" Click="AnchorButton_OnClick" />
                                            <Button Grid.Row="1" Grid.Column="2" Tag="2,1" Style="{StaticResource GlassAnchorButtonStyle}" Click="AnchorButton_OnClick" />
                                            <Button Grid.Row="2" Grid.Column="0" Tag="0,2" Style="{StaticResource GlassAnchorButtonStyle}" Click="AnchorButton_OnClick" />
                                            <Button Grid.Row="2" Grid.Column="1" Tag="1,2" Style="{StaticResource GlassAnchorButtonStyle}" Click="AnchorButton_OnClick" />
                                            <Button Grid.Row="2" Grid.Column="2" Tag="2,2" Style="{StaticResource GlassAnchorButtonStyle}" Click="AnchorButton_OnClick" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                            <TextBlock Style="{StaticResource GlassLabelStyle}" Text="Быстрая привязка" />
                                            <TextBlock Style="{StaticResource GlassCaptionStyle}" Text="Или перетащите виджет мышью — он прилипает к сетке. Shift отключает привязку." />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <TextBlock Margin="6,8,0,0" Style="{StaticResource GlassSectionTitleStyle}" Text="ПОВЕДЕНИЕ" />
                                <Border Style="{StaticResource GlassGroupStyle}">
                                    <StackPanel Spacing="12">
                                        <Grid>
                                            <TextBlock Style="{StaticResource GlassLabelStyle}" Text="Скрывать на паузе" />
                                            <ToggleSwitch Style="{StaticResource GlassToggleStyle}" IsOn="{x:Bind ViewModel.HideOnPause, Mode=TwoWay}" />
                                        </Grid>
                                        <StackPanel Spacing="10" Visibility="{x:Bind local:MainPage.VisibleIf(ViewModel.HideOnPause), Mode=OneWay}">
                                            <Grid>
                                                <TextBlock Style="{StaticResource GlassLabelStyle}" Text="Задержка" />
                                                <TextBlock Style="{StaticResource GlassValueStyle}" Text="{x:Bind local:MainPage.FormatSeconds(ViewModel.PauseHideDelaySeconds), Mode=OneWay}" />
                                            </Grid>
                                            <Slider Style="{StaticResource GlassSliderStyle}" Minimum="1" Maximum="20" StepFrequency="0.5" Value="{x:Bind ViewModel.PauseHideDelaySeconds, Mode=TwoWay}" />
                                        </StackPanel>
                                        <Grid>
                                            <StackPanel Margin="0,0,60,0">
                                                <TextBlock Style="{StaticResource GlassLabelStyle}" Text="Ручка перетаскивания" />
                                                <TextBlock Style="{StaticResource GlassCaptionStyle}" Text="Полоска над текстом при наведении" />
                                            </StackPanel>
                                            <ToggleSwitch Style="{StaticResource GlassToggleStyle}" IsOn="{x:Bind ViewModel.ShowDragHandle, Mode=TwoWay}" />
                                        </Grid>
                                        <Grid>
                                            <TextBlock Style="{StaticResource GlassLabelStyle}" Text="Запуск вместе с Windows" />
                                            <ToggleSwitch Style="{StaticResource GlassToggleStyle}" IsOn="{x:Bind ViewModel.RunAtStartup, Mode=TwoWay}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <TextBlock
                                    Margin="6,2,6,0"
                                    Style="{StaticResource GlassCaptionStyle}"
                                    Text="Виджет живёт только на рабочем столе: он всегда под окнами приложений и появляется, когда вы смотрите на обои." />
                            </StackPanel>

                            <!-- ============================== Page 4: More -->
                            <StackPanel x:Name="SettingsPageMore" Spacing="8" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource GlassSectionTitleStyle}" Text="ТЕКСТ ПЕСНИ" />
                                <Border Style="{StaticResource GlassGroupStyle}">
                                    <TextBlock Style="{StaticResource GlassCaptionStyle}" Text="{x:Bind ViewModel.SourceText, Mode=OneWay}" />
                                </Border>

                                <TextBlock Margin="6,8,0,0" Style="{StaticResource GlassSectionTitleStyle}" Text="ОБНОВЛЕНИЯ" />
                                <Border Style="{StaticResource GlassGroupStyle}">
                                    <StackPanel Spacing="10">
                                        <Grid>
                                            <TextBlock Style="{StaticResource GlassLabelStyle}" Text="Версия" />
                                            <TextBlock Style="{StaticResource GlassValueStyle}" Text="{x:Bind ViewModel.AppVersionText, Mode=OneWay}" />
                                        </Grid>
                                        <TextBlock Style="{StaticResource GlassCaptionStyle}" Text="{x:Bind ViewModel.UpdateStatusText, Mode=OneWay}" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Style="{StaticResource GlassActionButtonStyle}" Click="CheckForUpdatesButton_OnClick" Content="Проверить" />
                                            <Button Grid.Column="1" Style="{StaticResource GlassActionButtonStyle}" Click="OpenReleasesButton_OnClick" Content="Релизы" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <TextBlock Margin="6,8,0,0" Style="{StaticResource GlassSectionTitleStyle}" Text="ФАЙЛЫ" />
                                <Border Style="{StaticResource GlassGroupStyle}">
                                    <Grid ColumnSpacing="8" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Button Style="{StaticResource GlassActionButtonStyle}" Click="OpenConfigFolderButton_OnClick" Content="Папка настроек" />
                                        <Button Grid.Column="1" Style="{StaticResource GlassActionButtonStyle}" Click="OpenConfigFileButton_OnClick" Content="settings.json" />
                                        <Button Grid.Row="1" Style="{StaticResource GlassActionButtonStyle}" Click="OpenLogsFolderButton_OnClick" Content="Логи" />
                                        <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource GlassActionButtonStyle}" Click="ExportDebugSnapshotButton_OnClick" Content="Снимок отладки" />
                                    </Grid>
                                </Border>

                                <TextBlock Margin="6,8,0,0" Style="{StaticResource GlassSectionTitleStyle}" Text="ОТЛАДКА" />
                                <Border Style="{StaticResource GlassGroupStyle}">
                                    <StackPanel Spacing="12">
                                        <Grid>
                                            <TextBlock Style="{StaticResource GlassLabelStyle}" Text="Рамки элементов" />
                                            <ToggleSwitch Style="{StaticResource GlassToggleStyle}" IsOn="{x:Bind ViewModel.ShowDebugHitboxes, Mode=TwoWay}" />
                                        </Grid>
                                        <Grid>
                                            <TextBlock Style="{StaticResource GlassLabelStyle}" Text="Панель диагностики" />
                                            <ToggleSwitch Style="{StaticResource GlassToggleStyle}" IsOn="{x:Bind ViewModel.ShowRuntimeDebugPanel, Mode=TwoWay}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Button
                                    Margin="0,8,0,0"
                                    Style="{StaticResource GlassActionButtonStyle}"
                                    Foreground="#FFFFB4B4"
                                    Click="ResetAllSettingsButton_OnClick"
                                    Content="Сбросить все настройки" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Canvas>

        <Border
            Canvas.ZIndex="500"
            Margin="14"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Visibility="{x:Bind ViewModel.RuntimeDebugPanelVisibility, Mode=OneWay}"
            IsHitTestVisible="False"
            MaxWidth="960"
            Padding="10"
            Background="#C0101010"
            BorderBrush="#5FFFFFFF"
            BorderThickness="1"
            CornerRadius="8">
            <ScrollViewer
                MaxHeight="260"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto"
                ZoomMode="Disabled">
                <TextBlock
                    x:Name="RuntimeDebugPanelText"
                    FontFamily="Consolas"
                    FontSize="12"
                    Foreground="#FFE6EEF6"
                    TextWrapping="NoWrap"
                    IsTextSelectionEnabled="True" />
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
