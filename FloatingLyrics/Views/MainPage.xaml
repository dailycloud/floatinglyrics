<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="FloatingLyrics.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:models="using:FloatingLyrics.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <Style
            x:Key="SettingsFlyoutPresenterStyle"
            TargetType="FlyoutPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style
            x:Key="SettingsSectionCardStyle"
            TargetType="Border">
            <Setter Property="Padding" Value="7" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#2C3C4E63" />
            <Setter Property="Background" Value="#C2151C27" />
            <Setter Property="Margin" Value="0,0,0,0" />
        </Style>

        <Style
            x:Key="SettingsSectionTitleStyle"
            TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display Semibold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#EAF2FD" />
        </Style>

        <Style
            x:Key="SettingsSectionCaptionStyle"
            TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Foreground" Value="#7889A0" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>

        <Style
            x:Key="SettingsFieldLabelStyle"
            TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text Semibold" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="#D6E0F0" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>

        <Style
            x:Key="SettingsFieldCaptionStyle"
            TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="#8394AD" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>

        <Style
            x:Key="SettingsHeaderIconButtonStyle"
            TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="26" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="#1A2434" />
            <Setter Property="BorderBrush" Value="#45607E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#E8F2FF" />
        </Style>

        <LinearGradientBrush x:Key="DragBarBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#9FFFFFFF" Offset="0" />
            <GradientStop Color="#80F2F4F8" Offset="0.55" />
            <GradientStop Color="#66E1E6EF" Offset="1" />
        </LinearGradientBrush>

        <Storyboard x:Key="WaitingDotsStoryboard" RepeatBehavior="Forever">
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="WaitDot1Translate"
                Storyboard.TargetProperty="Y"
                Duration="0:0:1.35">
                <SplineDoubleKeyFrame KeyTime="0:0:0.00" Value="0" KeySpline="0.25,0.10,0.25,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.24" Value="-6.8" KeySpline="0.30,0.00,0.30,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.52" Value="0" KeySpline="0.35,0.00,0.35,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:1.35" Value="0" KeySpline="0.25,0.10,0.25,1.00" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="WaitDot1"
                Storyboard.TargetProperty="Opacity"
                Duration="0:0:1.35">
                <SplineDoubleKeyFrame KeyTime="0:0:0.00" Value="0.28" KeySpline="0.30,0.00,0.30,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.24" Value="1.00" KeySpline="0.30,0.00,0.30,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.52" Value="0.30" KeySpline="0.30,0.00,0.30,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:1.35" Value="0.30" KeySpline="0.30,0.00,0.30,1.00" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="WaitDot1Scale"
                Storyboard.TargetProperty="ScaleX"
                Duration="0:0:1.35">
                <SplineDoubleKeyFrame KeyTime="0:0:0.00" Value="1.00" KeySpline="0.30,0.00,0.30,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.24" Value="1.18" KeySpline="0.30,0.00,0.30,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.52" Value="1.00" KeySpline="0.30,0.00,0.30,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:1.35" Value="1.00" KeySpline="0.30,0.00,0.30,1.00" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="WaitDot1Scale"
                Storyboard.TargetProperty="ScaleY"
                Duration="0:0:1.35">
                <SplineDoubleKeyFrame KeyTime="0:0:0.00" Value="1.00" KeySpline="0.30,0.00,0.30,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.24" Value="1.18" KeySpline="0.30,0.00,0.30,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.52" Value="1.00" KeySpline="0.30,0.00,0.30,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:1.35" Value="1.00" KeySpline="0.30,0.00,0.30,1.00" />
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="WaitDot2Translate"
                Storyboard.TargetProperty="Y"
                Duration="0:0:1.35">
                <SplineDoubleKeyFrame KeyTime="0:0:0.00" Value="0" KeySpline="0.25,0.10,0.25,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.18" Value="0" KeySpline="0.25,0.10,0.25,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.42" Value="-6.8" KeySpline="0.30,0.00,0.30,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.70" Value="0" KeySpline="0.35,0.00,0.35,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:1.35" Value="0" KeySpline="0.25,0.10,0.25,1.00" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="WaitDot2"
                Storyboard.TargetProperty="Opacity"
                Duration="0:0:1.35">
                <SplineDoubleKeyFrame KeyTime="0:0:0.00" Value="0.28" KeySpline="0.30,0.00,0.30,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.18" Value="0.28" KeySpline="0.30,0.00,0.30,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.42" Value="1.00" KeySpline="0.30,0.00,0.30,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.70" Value="0.30" KeySpline="0.30,0.00,0.30,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:1.35" Value="0.30" KeySpline="0.30,0.00,0.30,1.00" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="WaitDot2Scale"
                Storyboard.TargetProperty="ScaleX"
                Duration="0:0:1.35">
                <SplineDoubleKeyFrame KeyTime="0:0:0.00" Value="1.00" KeySpline="0.30,0.00,0.30,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.18" Value="1.00" KeySpline="0.30,0.00,0.30,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.42" Value="1.18" KeySpline="0.30,0.00,0.30,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.70" Value="1.00" KeySpline="0.30,0.00,0.30,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:1.35" Value="1.00" KeySpline="0.30,0.00,0.30,1.00" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="WaitDot2Scale"
                Storyboard.TargetProperty="ScaleY"
                Duration="0:0:1.35">
                <SplineDoubleKeyFrame KeyTime="0:0:0.00" Value="1.00" KeySpline="0.30,0.00,0.30,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.18" Value="1.00" KeySpline="0.30,0.00,0.30,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.42" Value="1.18" KeySpline="0.30,0.00,0.30,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.70" Value="1.00" KeySpline="0.30,0.00,0.30,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:1.35" Value="1.00" KeySpline="0.30,0.00,0.30,1.00" />
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="WaitDot3Translate"
                Storyboard.TargetProperty="Y"
                Duration="0:0:1.35">
                <SplineDoubleKeyFrame KeyTime="0:0:0.00" Value="0" KeySpline="0.25,0.10,0.25,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.36" Value="0" KeySpline="0.25,0.10,0.25,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.60" Value="-6.8" KeySpline="0.30,0.00,0.30,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.88" Value="0" KeySpline="0.35,0.00,0.35,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:1.35" Value="0" KeySpline="0.25,0.10,0.25,1.00" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="WaitDot3"
                Storyboard.TargetProperty="Opacity"
                Duration="0:0:1.35">
                <SplineDoubleKeyFrame KeyTime="0:0:0.00" Value="0.28" KeySpline="0.30,0.00,0.30,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.36" Value="0.28" KeySpline="0.30,0.00,0.30,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.60" Value="1.00" KeySpline="0.30,0.00,0.30,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.88" Value="0.30" KeySpline="0.30,0.00,0.30,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:1.35" Value="0.30" KeySpline="0.30,0.00,0.30,1.00" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="WaitDot3Scale"
                Storyboard.TargetProperty="ScaleX"
                Duration="0:0:1.35">
                <SplineDoubleKeyFrame KeyTime="0:0:0.00" Value="1.00" KeySpline="0.30,0.00,0.30,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.36" Value="1.00" KeySpline="0.30,0.00,0.30,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.60" Value="1.18" KeySpline="0.30,0.00,0.30,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.88" Value="1.00" KeySpline="0.30,0.00,0.30,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:1.35" Value="1.00" KeySpline="0.30,0.00,0.30,1.00" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="WaitDot3Scale"
                Storyboard.TargetProperty="ScaleY"
                Duration="0:0:1.35">
                <SplineDoubleKeyFrame KeyTime="0:0:0.00" Value="1.00" KeySpline="0.30,0.00,0.30,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.36" Value="1.00" KeySpline="0.30,0.00,0.30,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.60" Value="1.18" KeySpline="0.30,0.00,0.30,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.88" Value="1.00" KeySpline="0.30,0.00,0.30,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:1.35" Value="1.00" KeySpline="0.30,0.00,0.30,1.00" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </Page.Resources>

    <Grid
        x:Name="RootGrid"
        Background="Transparent">
        <Grid
            x:Name="DragSnapOverlay"
            Visibility="Collapsed"
            IsHitTestVisible="False">
            <Canvas x:Name="DragSnapGridCanvas" />
            <Border
                x:Name="DragSnapHint"
                Margin="0,12,0,0"
                Padding="10,5"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                CornerRadius="8"
                BorderBrush="#44FFFFFF"
                BorderThickness="1"
                Background="#78101010">
                <TextBlock
                    x:Name="DragSnapHintText"
                    FontFamily="Segoe UI Variable Text"
                    FontSize="12"
                    Foreground="#E8FFFFFF"
                    Text="Привязка к сетке: ВКЛ • Ось: авто • Shift — игнорировать" />
            </Border>
        </Grid>

        <StackPanel
            x:Name="OverlayRootHost"
            Margin="32,32,32,32"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            SizeChanged="OverlayRootHost_OnSizeChanged"
            Spacing="6">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="OverlayRootHostTranslate" />
            </StackPanel.RenderTransform>

            <Grid
                x:Name="DragHandleSlot"
                Height="14"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top">
                <Border
                    x:Name="DragHandle"
                    Width="196"
                    Height="14"
                    Visibility="{x:Bind ViewModel.DragHandleVisibility, Mode=OneWay}"
                    Background="{StaticResource DragBarBackgroundBrush}"
                    BorderBrush="#80FFFFFF"
                    BorderThickness="1"
                    CornerRadius="9"
                    HorizontalAlignment="Center"
                    PointerCanceled="DragHandle_OnPointerCanceled"
                    PointerCaptureLost="DragHandle_OnPointerCaptureLost"
                    PointerMoved="DragHandle_OnPointerMoved"
                    PointerPressed="DragHandle_OnPointerPressed"
                    PointerReleased="DragHandle_OnPointerReleased">
                    <Grid>
                        <Rectangle
                            RadiusX="9"
                            RadiusY="9"
                            Fill="#12FFFFFF" />
                        <StackPanel
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="6"
                            Opacity="0.3">
                            <Ellipse Width="2" Height="2" Fill="#E8FFFFFF" />
                            <Ellipse Width="2" Height="2" Fill="#AAFFFFFF" />
                            <Ellipse Width="2" Height="2" Fill="#D2FFFFFF" />
                            <Ellipse Width="2" Height="2" Fill="#96FFFFFF" />
                            <Ellipse Width="2" Height="2" Fill="#C8FFFFFF" />
                            <Ellipse Width="2" Height="2" Fill="#A8FFFFFF" />
                            <Ellipse Width="2" Height="2" Fill="#DCFFFFFF" />
                            <Ellipse Width="2" Height="2" Fill="#98FFFFFF" />
                            <Ellipse Width="2" Height="2" Fill="#C0FFFFFF" />
                            <Ellipse Width="2" Height="2" Fill="#8CFFFFFF" />
                            <Ellipse Width="2" Height="2" Fill="#DAFFFFFF" />
                        </StackPanel>
                    </Grid>
                    <ToolTipService.ToolTip>
                        <TextBlock Text="LMB: move overlay content, RMB: settings." />
                    </ToolTipService.ToolTip>
                    <Border.ContextFlyout>
                    <Flyout
                        ShouldConstrainToRootBounds="False"
                        FlyoutPresenterStyle="{StaticResource SettingsFlyoutPresenterStyle}">
                        <Border
                            x:Name="SettingsFlyoutRoot"
                            Width="276"
                            MaxHeight="460"
                            Padding="6"
                            CornerRadius="9"
                            BorderThickness="1"
                            BorderBrush="#4A5E78">
                            <Border.Background>
                                <SolidColorBrush Color="#F10E131B" />
                            </Border.Background>
                            <Border.Resources>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#1A2433" />
                                    <Setter Property="BorderBrush" Value="#354B63" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="CornerRadius" Value="6" />
                                    <Setter Property="Foreground" Value="#EAF2FF" />
                                    <Setter Property="Padding" Value="8,4" />
                                    <Setter Property="FontSize" Value="11" />
                                    <Setter Property="MinHeight" Value="26" />
                                </Style>
                            </Border.Resources>
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="SettingsFlyoutDragTransform" />
                            </Border.RenderTransform>
                            <Border.Shadow>
                                <ThemeShadow />
                            </Border.Shadow>
                            <Grid RowSpacing="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid
                                    x:Name="SettingsFlyoutHeader"
                                    Padding="2,0,2,1"
                                    ColumnSpacing="6"
                                    PointerPressed="SettingsFlyoutHeader_OnPointerPressed"
                                    PointerMoved="SettingsFlyoutHeader_OnPointerMoved"
                                    PointerReleased="SettingsFlyoutHeader_OnPointerReleased"
                                    PointerCanceled="SettingsFlyoutHeader_OnPointerReleased"
                                    PointerCaptureLost="SettingsFlyoutHeader_OnPointerReleased">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Grid.Row="0"
                                        Grid.ColumnSpan="2"
                                        Height="4"
                                        Margin="0,1,0,4"
                                        HorizontalAlignment="Stretch"
                                        CornerRadius="2.5"
                                        Background="#202D3C"
                                        BorderBrush="#445A73"
                                        BorderThickness="1" />

                                    <TextBlock
                                        Grid.Row="1"
                                        VerticalAlignment="Center"
                                        Foreground="#8A9DB6"
                                        FontSize="10"
                                        Text=" " />

                                    <Button
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Top"
                                        Style="{StaticResource SettingsHeaderIconButtonStyle}"
                                        Click="SettingsRefreshButton_OnClick"
                                        ToolTipService.ToolTip="Refresh">
                                        <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                    </Button>

                                    <Button
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        VerticalAlignment="Top"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource SettingsHeaderIconButtonStyle}"
                                        Click="CloseSettingsButton_OnClick"
                                        ToolTipService.ToolTip="Close">
                                        <FontIcon Glyph="&#xE711;" FontSize="13" />
                                    </Button>
                                </Grid>

                                <ScrollViewer
                                    Grid.Row="1"
                                    Margin="0,0,0,0"
                                    VerticalScrollMode="Enabled"
                                    VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="8">
                                        <Border Style="{StaticResource SettingsSectionCardStyle}">
                                            <StackPanel Spacing="6">
                                                <TextBlock Style="{StaticResource SettingsSectionTitleStyle}" Text="Playback &amp; Window" />
                                                <TextBlock Style="{StaticResource SettingsSectionCaptionStyle}" Text="Widget mode, pause behavior and startup." />
                                                <CheckBox Content="Desktop widget mode" IsChecked="{x:Bind ViewModel.DesktopWidgetMode, Mode=TwoWay}" />
                                                <CheckBox Content="Show drag-bar" IsChecked="{x:Bind ViewModel.ShowDragHandle, Mode=TwoWay}" />
                                                <CheckBox Content="Always on top" IsChecked="{x:Bind ViewModel.AlwaysOnTop, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.AlwaysOnTopToggleEnabled, Mode=OneWay}" />
                                                <CheckBox Content="Hide overlay on pause" IsChecked="{x:Bind ViewModel.HideOnPause, Mode=TwoWay}" />
                                                <StackPanel Spacing="3">
                                                    <TextBlock Style="{StaticResource SettingsFieldLabelStyle}" Text="Pause hide delay" />
                                                    <Slider Minimum="1" Maximum="20" StepFrequency="0.5" Value="{x:Bind ViewModel.PauseHideDelaySeconds, Mode=TwoWay}" />
                                                    <TextBlock Style="{StaticResource SettingsFieldCaptionStyle}" Text="{x:Bind ViewModel.PauseHideDelayText, Mode=OneWay}" />
                                                </StackPanel>
                                                <StackPanel Spacing="3">
                                                    <TextBlock Style="{StaticResource SettingsFieldLabelStyle}" Text="Overlay width" />
                                                    <Slider Minimum="360" Maximum="1720" StepFrequency="4" Value="{x:Bind ViewModel.OverlayWidth, Mode=TwoWay}" />
                                                </StackPanel>
                                                <CheckBox Content="Run at Windows startup" IsChecked="{x:Bind ViewModel.RunAtStartup, Mode=TwoWay}" />
                                                <CheckBox Content="Start in desktop-widget mode" IsChecked="{x:Bind ViewModel.StartInDesktopWidgetMode, Mode=TwoWay}" />
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SettingsSectionCardStyle}">
                                            <StackPanel Spacing="6">
                                                <TextBlock Style="{StaticResource SettingsSectionTitleStyle}" Text="Lyrics Motion" />
                                                <TextBlock Style="{StaticResource SettingsSectionCaptionStyle}" Text="Text alignment and line animation." />
                                                <CheckBox Content="Show line timings" IsChecked="{x:Bind ViewModel.ShowLineTimings, Mode=TwoWay}" />
                                                <CheckBox Content="Show cover art" IsChecked="{x:Bind ViewModel.ShowCoverArt, Mode=TwoWay}" />
                                                <CheckBox Content="Auto text alignment" IsChecked="{x:Bind ViewModel.AutoLyricsTextAlignment, Mode=TwoWay}" />
                                                <StackPanel Spacing="3">
                                                    <TextBlock Style="{StaticResource SettingsFieldLabelStyle}" Text="Manual text alignment" />
                                                    <ComboBox
                                                        ItemsSource="{x:Bind ViewModel.LyricsTextAlignmentOptions, Mode=OneWay}"
                                                        SelectedValuePath="Mode"
                                                        SelectedValue="{x:Bind ViewModel.LyricsTextAlignment, Mode=OneWay}"
                                                        SelectionChanged="ManualLyricsAlignmentComboBox_OnSelectionChanged">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="models:LyricsTextAlignmentOption">
                                                                <TextBlock Text="{x:Bind Label}" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Spacing="3">
                                                    <TextBlock Style="{StaticResource SettingsFieldLabelStyle}" Text="Line transition duration" />
                                                    <Slider Minimum="0.12" Maximum="1.2" StepFrequency="0.01" Value="{x:Bind ViewModel.LineAnimationDurationSeconds, Mode=TwoWay}" />
                                                </StackPanel>
                                                <StackPanel Spacing="3">
                                                    <TextBlock Style="{StaticResource SettingsFieldLabelStyle}" Text="Current line font size" />
                                                    <Slider Minimum="20" Maximum="84" StepFrequency="1" Value="{x:Bind ViewModel.CurrentLineFontSize, Mode=TwoWay}" />
                                                </StackPanel>
                                                <StackPanel Spacing="3">
                                                    <TextBlock Style="{StaticResource SettingsFieldLabelStyle}" Text="Next line font size" />
                                                    <Slider Minimum="16" Maximum="54" StepFrequency="1" Value="{x:Bind ViewModel.NextLineFontSize, Mode=TwoWay}" />
                                                </StackPanel>
                                                <StackPanel Spacing="3">
                                                    <TextBlock Style="{StaticResource SettingsFieldLabelStyle}" Text="Gap between lines" />
                                                    <Slider Minimum="0" Maximum="48" StepFrequency="1" Value="{x:Bind ViewModel.NextLineTopMargin, Mode=TwoWay}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SettingsSectionCardStyle}">
                                            <StackPanel Spacing="6">
                                                <TextBlock Style="{StaticResource SettingsSectionTitleStyle}" Text="Oscilloscope" />
                                                <TextBlock Style="{StaticResource SettingsSectionCaptionStyle}" Text="FFT response and mirror mode." />
                                                <CheckBox Content="Mirror bars" IsChecked="{x:Bind ViewModel.OscilloscopeMirrorBars, Mode=TwoWay}" />
                                                <CheckBox Content="App-scoped capture (beta)" IsChecked="{x:Bind ViewModel.AppScopedAudioCapture, Mode=TwoWay}" />
                                                <StackPanel Spacing="3">
                                                    <TextBlock Style="{StaticResource SettingsFieldLabelStyle}" Text="Responsiveness" />
                                                    <Slider Minimum="0.08" Maximum="0.95" StepFrequency="0.01" Value="{x:Bind ViewModel.OscilloscopeResponsiveness, Mode=TwoWay}" />
                                                </StackPanel>
                                                <StackPanel Spacing="3">
                                                    <TextBlock Style="{StaticResource SettingsFieldLabelStyle}" Text="Sensitivity" />
                                                    <Slider Minimum="0.5" Maximum="2.6" StepFrequency="0.01" Value="{x:Bind ViewModel.OscilloscopeSensitivity, Mode=TwoWay}" />
                                                </StackPanel>
