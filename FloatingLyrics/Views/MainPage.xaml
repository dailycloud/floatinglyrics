<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="FloatingLyrics.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:FloatingLyrics.Controls"
    xmlns:local="using:FloatingLyrics.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <!-- ============================================================ glass UI kit -->
        <FontFamily x:Key="GlassUiFont">Segoe UI Variable Text</FontFamily>
        <FontFamily x:Key="GlassUiDisplayFont">Segoe UI Variable Display</FontFamily>
        <FontFamily x:Key="GlassIconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <SolidColorBrush x:Key="GlassTextPrimary" Color="#F7FFFFFF" />
        <SolidColorBrush x:Key="GlassTextSecondary" Color="#B8FFFFFF" />
        <SolidColorBrush x:Key="GlassTextTertiary" Color="#80FFFFFF" />
        <SolidColorBrush x:Key="GlassFillSubtle" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="GlassFillHover" Color="#24FFFFFF" />
        <SolidColorBrush x:Key="GlassFillPressed" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="GlassFillSelected" Color="#3DFFFFFF" />
        <SolidColorBrush x:Key="GlassStroke" Color="#26FFFFFF" />
        <SolidColorBrush x:Key="GlassStrokeStrong" Color="#59FFFFFF" />

        <!-- Lightweight styling for stock controls hosted on glass. -->
        <SolidColorBrush x:Key="SliderTrackFill" Color="#2EFFFFFF" />
        <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#3DFFFFFF" />
        <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#47FFFFFF" />
        <SolidColorBrush x:Key="SliderTrackValueFill" Color="#F2FFFFFF" />
        <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FFEFF3F8" />
        <SolidColorBrush x:Key="SliderOuterThumbBackground" Color="#40000000" />
        <SolidColorBrush x:Key="SliderHeaderForeground" Color="#F7FFFFFF" />

        <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#E6FFFFFF" />
        <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#D9FFFFFF" />
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FF1A1F28" />
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FF1A1F28" />
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FF1A1F28" />
        <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#1FFFFFFF" />
        <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#2EFFFFFF" />
        <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="#3DFFFFFF" />
        <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#66FFFFFF" />
        <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#99FFFFFF" />
        <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="#99FFFFFF" />
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#CCFFFFFF" />
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#00FFFFFF" />
        <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#00FFFFFF" />
        <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#00FFFFFF" />

        <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#1AFFFFFF" />
        <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#2EFFFFFF" />
        <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#40FFFFFF" />
        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#4DFFFFFF" />
        <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="#FFFFFFFF" />

        <Style x:Key="GlassSliderStyle" TargetType="Slider">
            <Setter Property="IsThumbToolTipEnabled" Value="False" />
            <Setter Property="Margin" Value="0,-4,0,-6" />
            <Setter Property="IsFocusEngagementEnabled" Value="False" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
        </Style>

        <Style x:Key="GlassToggleStyle" TargetType="ToggleSwitch">
            <Setter Property="OnContent" Value="" />
            <Setter Property="OffContent" Value="" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleSwitch">
                        <Grid Width="44" Height="24" Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver" />
                                    <VisualState x:Name="Pressed" />
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="SwitchContainer.Opacity" Value="0.45" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="ToggleStates">
                                    <VisualState x:Name="Off">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobTranslate" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="On">
                                        <VisualState.Setters>
                                            <Setter Target="OuterBorder.Background" Value="{ThemeResource ToggleSwitchFillOn}" />
                                            <Setter Target="OuterBorder.BorderBrush" Value="{ThemeResource ToggleSwitchStrokeOn}" />
                                            <Setter Target="SwitchKnob.Fill" Value="{ThemeResource ToggleSwitchKnobFillOn}" />
                                        </VisualState.Setters>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobTranslate" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.16" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid x:Name="SwitchContainer" Width="44" Height="24">
                                <Border x:Name="OuterBorder"
                                        Width="44"
                                        Height="24"
                                        CornerRadius="12"
                                        BorderThickness="1"
                                        Background="{ThemeResource ToggleSwitchFillOff}"
                                        BorderBrush="{ThemeResource ToggleSwitchStrokeOff}" />
                                <Border x:Name="SwitchKnobBounds" Padding="3">
                                    <Ellipse x:Name="SwitchKnob"
                                             Width="16"
                                             Height="16"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Center"
                                             Fill="{ThemeResource ToggleSwitchKnobFillOff}">
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform x:Name="KnobTranslate" X="0" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Border>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource GlassUiFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CharacterSpacing" Value="40" />
            <Setter Property="Foreground" Value="{StaticResource GlassTextTertiary}" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>

        <Style x:Key="GlassLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource GlassUiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource GlassTextPrimary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>

        <Style x:Key="GlassValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource GlassUiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource GlassTextSecondary}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="GlassCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource GlassUiFont}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource GlassTextTertiary}" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>

        <!-- Grouped "card" inside the glass panel (iOS-style inset group). -->
        <Style x:Key="GlassGroupStyle" TargetType="Border">
            <Setter Property="Background" Value="#12FFFFFF" />
            <Setter Property="BorderBrush" Value="#1CFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="14,12" />
        </Style>

        <Style x:Key="GlassIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource GlassTextPrimary}" />
            <Setter Property="FontFamily" Value="{StaticResource GlassIconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="RootScale" />
                            </Grid.RenderTransform>
                            <Ellipse x:Name="Fill" Fill="{StaticResource GlassFillSubtle}" Stroke="{StaticResource GlassStroke}" StrokeThickness="1" />
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                Foreground="{TemplateBinding Foreground}"
                                FontFamily="{TemplateBinding FontFamily}"
                                FontSize="{TemplateBinding FontSize}" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.16" />
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Fill.Fill" Value="{StaticResource GlassFillHover}" />
                                            <Setter Target="Fill.Stroke" Value="{StaticResource GlassStrokeStrong}" />
                                            <Setter Target="RootScale.ScaleX" Value="1.06" />
                                            <Setter Target="RootScale.ScaleY" Value="1.06" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Fill.Fill" Value="{StaticResource GlassFillPressed}" />
                                            <Setter Target="RootScale.ScaleX" Value="0.92" />
                                            <Setter Target="RootScale.ScaleY" Value="0.92" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassActionButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Foreground" Value="{StaticResource GlassTextPrimary}" />
            <Setter Property="FontFamily" Value="{StaticResource GlassUiFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="RootScale" />
                            </Grid.RenderTransform>
                            <Border
                                x:Name="Fill"
                                CornerRadius="12"
                                Background="{StaticResource GlassFillSubtle}"
                                BorderBrush="{StaticResource GlassStroke}"
                                BorderThickness="1" />
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                Foreground="{TemplateBinding Foreground}"
                                FontFamily="{TemplateBinding FontFamily}"
                                FontSize="{TemplateBinding FontSize}" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.14" />
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Fill.Background" Value="{StaticResource GlassFillHover}" />
                                            <Setter Target="Fill.BorderBrush" Value="{StaticResource GlassStrokeStrong}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Fill.Background" Value="{StaticResource GlassFillPressed}" />
                                            <Setter Target="RootScale.ScaleX" Value="0.97" />
                                            <Setter Target="RootScale.ScaleY" Value="0.97" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented-control chip: a RadioButton without the radio glyph. -->
        <Style x:Key="GlassChipStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource GlassTextSecondary}" />
            <Setter Property="FontFamily" Value="{StaticResource GlassUiFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="RootScale" />
                            </Grid.RenderTransform>
                            <Border
                                x:Name="Pill"
                                CornerRadius="11"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1" />
                            <ContentPresenter
                                x:Name="Presenter"
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                Foreground="{TemplateBinding Foreground}"
                                FontFamily="{TemplateBinding FontFamily}"
                                FontSize="{TemplateBinding FontSize}"
                                TextWrapping="NoWrap" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.14" />
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Pill.Background" Value="{StaticResource GlassFillSubtle}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Pill.Background" Value="{StaticResource GlassFillHover}" />
                                            <Setter Target="RootScale.ScaleX" Value="0.96" />
                                            <Setter Target="RootScale.ScaleY" Value="0.96" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.22">
                                            <VisualTransition.GeneratedEasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </VisualTransition.GeneratedEasingFunction>
                                        </VisualTransition>
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Pill.Background" Value="{StaticResource GlassFillSelected}" />
                                            <Setter Target="Pill.BorderBrush" Value="{StaticResource GlassStrokeStrong}" />
                                            <Setter Target="Presenter.Foreground" Value="#FFFFFFFF" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round colour swatch; the swatch colour comes from Background. -->
        <Style x:Key="GlassSwatchStyle" TargetType="RadioButton">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="RootScale" />
                            </Grid.RenderTransform>
                            <Ellipse x:Name="Ring" Stroke="#00FFFFFF" StrokeThickness="2" />
                            <Ellipse Margin="4" Fill="{TemplateBinding Background}" Stroke="#40FFFFFF" StrokeThickness="1" />
                            <Ellipse Margin="4" Opacity="0.55">
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0" Color="#66FFFFFF" />
                                        <GradientStop Offset="0.5" Color="#00FFFFFF" />
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.14" />
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootScale.ScaleX" Value="1.1" />
                                            <Setter Target="RootScale.ScaleY" Value="1.1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootScale.ScaleX" Value="0.92" />
                                            <Setter Target="RootScale.ScaleY" Value="0.92" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.2" />
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Ring.Stroke" Value="#F2FFFFFF" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassTabStyle" TargetType="RadioButton" BasedOn="{StaticResource GlassChipStyle}">
            <Setter Property="Padding" Value="4,7,4,6" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="GlassSegmentHostStyle" TargetType="Border">
            <Setter Property="Background" Value="#14000000" />
            <Setter Property="BorderBrush" Value="#1AFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Padding" Value="2" />
        </Style>

        <!-- Anchor picker cell (3x3 position grid). -->
        <Style x:Key="GlassAnchorButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Background="Transparent">
                            <Border x:Name="Cell" CornerRadius="7" Background="#10FFFFFF" BorderBrush="#1CFFFFFF" BorderThickness="1" />
                            <Ellipse x:Name="Dot" Width="6" Height="6" Fill="#99FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.12" />
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Cell.Background" Value="#24FFFFFF" />
                                            <Setter Target="Dot.Fill" Value="#FFFFFFFF" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Cell.Background" Value="#3DFFFFFF" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Storyboard x:Key="WaitingDotsStoryboard" RepeatBehavior="Forever">
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="WaitDot1Translate"
                Storyboard.TargetProperty="Y"
                Duration="0:0:1.35">
                <SplineDoubleKeyFrame KeyTime="0:0:0.00" Value="0" KeySpline="0.25,0.10,0.25,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.24" Value="-6.8" KeySpline="0.30,0.00,0.30,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.52" Value="0" KeySpline="0.35,0.00,0.35,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:1.35" Value="0" KeySpline="0.25,0.10,0.25,1.00" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="WaitDot1"
                Storyboard.TargetProperty="Opacity"
                Duration="0:0:1.35">
                <SplineDoubleKeyFrame KeyTime="0:0:0.00" Value="0.28" KeySpline="0.30,0.00,0.30,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.24" Value="1.00" KeySpline="0.30,0.00,0.30,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.52" Value="0.30" KeySpline="0.30,0.00,0.30,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:1.35" Value="0.30" KeySpline="0.30,0.00,0.30,1.00" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="WaitDot1Scale"
                Storyboard.TargetProperty="ScaleX"
                Duration="0:0:1.35">
                <SplineDoubleKeyFrame KeyTime="0:0:0.00" Value="1.00" KeySpline="0.30,0.00,0.30,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.24" Value="1.18" KeySpline="0.30,0.00,0.30,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.52" Value="1.00" KeySpline="0.30,0.00,0.30,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:1.35" Value="1.00" KeySpline="0.30,0.00,0.30,1.00" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="WaitDot1Scale"
                Storyboard.TargetProperty="ScaleY"
                Duration="0:0:1.35">
                <SplineDoubleKeyFrame KeyTime="0:0:0.00" Value="1.00" KeySpline="0.30,0.00,0.30,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.24" Value="1.18" KeySpline="0.30,0.00,0.30,1.00" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.52" Value="1.00" KeySpline="0.30,0.00,0.30,1.00" />
